{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Notepad",
  "version": "0.1.0",
  "identifier": "io.notepad.workspace",
  "build": {
    "beforeDevCommand": {
      "script": "bun run dev",
      "cwd": "../.."
    },
    "beforeBuildCommand": {
      "script": "bun run build",
      "cwd": "../.."
    },
    "devUrl": "http://127.0.0.1:8080",
    "frontendDist": "../../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Notepad",
        "width": 1280,
        "height": 850,
        "minWidth": 375,
        "minHeight": 580,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self' 'wasm-unsafe-eval'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self'; connect-src ipc: http://ipc.localhost; object-src 'none'; base-uri 'self'; frame-src 'none'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "shortDescription": "A notebook with room to think",
    "category": "Productivity",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
